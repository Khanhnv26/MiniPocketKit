<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dialog_outer_padding_h"
    android:layout_marginVertical="@dimen/dialog_outer_padding_v"
    android:background="@drawable/bg_dialog_frost"
    android:orientation="vertical"
    android:padding="@dimen/dialog_inner_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/schedule_export_title"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_size_dialog_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvExportSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/chip_gap"
        android:lineSpacingExtra="@dimen/line_spacing_md"
        android:textColor="@color/ink_secondary"
        android:textSize="@dimen/text_size_input" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_field_gap"
        android:text="@string/schedule_export_format_label"
        android:textColor="@color/ink_secondary"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_label_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipExportXlsx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:background="@drawable/bg_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:paddingHorizontal="@dimen/tight_gap"
            android:singleLine="true"
            android:text="@string/schedule_export_format_xlsx"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipExportCsv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/day_chip_gap"
            android:layout_weight="0.95"
            android:background="@drawable/bg_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:paddingHorizontal="@dimen/tight_gap"
            android:singleLine="true"
            android:text="@string/schedule_export_format_csv"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipExportJson"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/day_chip_gap"
            android:layout_weight="1.0"
            android:background="@drawable/bg_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:paddingHorizontal="@dimen/tight_gap"
            android:singleLine="true"
            android:text="@string/schedule_export_format_json"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_padding"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnExportSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/schedule_export_btn_save"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnExportShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_button_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_accent_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/schedule_export_btn_share"
            android:textColor="@color/accent_sapphire"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnExportOnlineShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_button_gap"
        android:background="@drawable/bg_pill_accent_soft"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/schedule_export_btn_online_share"
        android:textColor="@color/accent_sapphire"
        android:textSize="@dimen/text_size_input"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnExportTemplate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_button_gap"
        android:background="@drawable/bg_pill_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/schedule_export_btn_template"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_size_input"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnExportClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_button_gap"
        android:background="@drawable/bg_pill_secondary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/schedule_export_btn_close"
        android:textColor="@color/ink_secondary"
        android:textSize="@dimen/text_size_input"
        android:textStyle="bold" />
</LinearLayout>
