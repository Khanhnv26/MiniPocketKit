<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/dialog_label_gap">

    <FrameLayout
        android:id="@+id/btnTaskCheckArea"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/notes_done_desc"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/taskCheckBox"
            android:layout_width="@dimen/checkbox_box_size"
            android:layout_height="@dimen/checkbox_box_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_unchecked">

            <ImageView
                android:id="@+id/ivTaskCheck"
                android:layout_width="@dimen/checkbox_check_size"
                android:layout_height="@dimen/checkbox_check_size"
                android:layout_gravity="center"
                android:contentDescription="@string/notes_done_desc"
                android:src="@drawable/ic_check_white"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/day_chip_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTaskMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/micro_gap"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chip_gap"
        android:background="@drawable/bg_pill_neutral_soft"
        android:paddingHorizontal="@dimen/dialog_button_gap"
        android:paddingVertical="@dimen/badge_padding_v"
        android:textColor="@color/ink_secondary"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold" />
</LinearLayout>
