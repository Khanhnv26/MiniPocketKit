<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSlotTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_accent_soft"
            android:fontFeatureSettings="tnum"
            android:paddingHorizontal="@dimen/badge_padding_h"
            android:paddingVertical="@dimen/badge_padding_v"
            android:textColor="@color/accent_sapphire"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSlotRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_button_gap"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSlotSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_button_gap"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_size_section_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSlotLecturer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tight_gap"
        android:textColor="@color/ink_secondary"
        android:textSize="@dimen/text_size_body" />

    <TextView
        android:id="@+id/tvSlotNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tight_gap"
        android:textColor="@color/ink_muted"
        android:textSize="@dimen/text_size_caption"
        android:visibility="gone" />
</LinearLayout>
