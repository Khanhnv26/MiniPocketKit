<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dialog_outer_padding_h"
    android:layout_marginVertical="@dimen/dialog_outer_padding_v"
    android:background="@drawable/bg_dialog_frost"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cloud_dialog_title"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_size_dialog_title"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipAuthLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/cloud_tab_login"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipAuthRegister"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chip_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/cloud_tab_register"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnAuthGoogle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:background="@drawable/bg_pill_accent_soft"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/cloud_btn_google"
        android:textColor="@color/accent_sapphire"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:gravity="center"
        android:text="@string/cloud_or_email_divider"
        android:textAllCaps="true"
        android:textColor="@color/ink_muted"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutAuthFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cloud_label_fullname"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAuthFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_label_gap"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/cloud_hint_fullname"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1"
            android:minHeight="@dimen/input_min_height"
            android:paddingHorizontal="@dimen/card_padding_compact"
            android:singleLine="true"
            android:textColor="@color/ink_primary"
            android:textColorHint="@color/ink_muted"
            android:textSize="@dimen/text_size_input" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:text="@string/cloud_label_email"
        android:textColor="@color/ink_secondary"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtAuthEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_label_gap"
        android:background="@drawable/bg_dialog_input"
        android:hint="@string/cloud_hint_email"
        android:imeOptions="actionNext"
        android:importantForAutofill="no"
        android:inputType="textEmailAddress"
        android:maxLines="1"
        android:minHeight="@dimen/input_min_height"
        android:paddingHorizontal="@dimen/card_padding_compact"
        android:singleLine="true"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_muted"
        android:textSize="@dimen/text_size_input" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:text="@string/cloud_label_password"
        android:textColor="@color/ink_secondary"
        android:textSize="@dimen/text_size_caption"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtAuthPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_label_gap"
        android:background="@drawable/bg_dialog_input"
        android:hint="@string/cloud_hint_password"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:maxLines="1"
        android:minHeight="@dimen/input_min_height"
        android:paddingHorizontal="@dimen/card_padding_compact"
        android:singleLine="true"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_muted"
        android:textSize="@dimen/text_size_input" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_section_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAuthCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/notes_dialog_cancel"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAuthSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_button_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/cloud_btn_submit"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
