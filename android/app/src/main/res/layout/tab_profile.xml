<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabProfile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cardProfileGuestHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_glass_hero"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_size_lg"
                android:layout_height="@dimen/icon_size_lg"
                android:background="@drawable/bg_icon_badge"
                android:contentDescription="@string/profile_guest_title"
                android:padding="@dimen/icon_badge_padding"
                android:src="@drawable/ic_profile"
                app:tint="@color/accent_sapphire" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_guest_title"
                    android:textColor="@color/ink_primary"
                    android:textSize="@dimen/text_size_section_title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/micro_gap"
                    android:text="@string/profile_guest_subtitle"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnProfileGoogleAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="@drawable/bg_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/cloud_btn_google"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloudAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chip_gap"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/cloud_btn_email_auth"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardProfileUserHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_glass_hero"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProfileAvatar"
                android:layout_width="@dimen/profile_avatar_size"
                android:layout_height="@dimen/profile_avatar_size"
                android:background="@drawable/bg_pill_primary"
                android:gravity="center"
                android:text="@string/profile_default_initials"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_avatar"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/section_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/profile_default_name"
                    android:textColor="@color/ink_primary"
                    android:textSize="@dimen/text_size_profile_name"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileMajor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/micro_gap"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/profile_default_major"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chip_gap"
                android:background="@drawable/bg_pill_secondary"
                android:clickable="true"
                android:contentDescription="@string/profile_edit_desc"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:paddingHorizontal="@dimen/chip_padding_h"
                android:text="@string/profile_btn_edit"
                android:textColor="@color/accent_sapphire"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/header_section_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_inner"
                android:orientation="vertical"
                android:padding="@dimen/card_gap">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_credits_label"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tvProfileCreditsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tight_gap"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink_primary"
                    android:textSize="@dimen/text_size_metric_value"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_button_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_inner"
                android:orientation="vertical"
                android:padding="@dimen/card_gap">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_attendance_label"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <TextView
                    android:id="@+id/tvProfileAttendanceValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tight_gap"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/accent_mint_text"
                    android:textSize="@dimen/text_size_metric_value"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_gpa_title"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_section_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGpaRankBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_success_soft"
                android:paddingHorizontal="@dimen/badge_padding_h"
                android:paddingVertical="@dimen/badge_padding_compact_v"
                android:text="@string/profile_gpa_rank_good"
                android:textColor="@color/accent_mint_text"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGpaProjected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_button_gap"
            android:fontFamily="sans-serif-black"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/accent_sapphire"
            android:textSize="@dimen/text_size_gpa_hero" />

        <TextView
            android:id="@+id/tvGpaBaselineSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/micro_gap"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_caption" />

        <ProgressBar
            android:id="@+id/pbGpaMeter"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_bar_height"
            android:layout_marginTop="@dimen/dialog_button_gap"
            android:max="400"
            android:progress="344"
            android:progressDrawable="@drawable/bg_progress_gpa" />

        <TextView
            android:id="@+id/tvSimulatedScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekSimulatedScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_label_gap"
            android:max="100"
            android:minHeight="@dimen/touch_target_min"
            android:progress="85"
            android:progressTint="@color/accent_sapphire"
            android:thumbTint="@color/accent_sapphire" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardCloudAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="@dimen/card_padding"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cloud_card_title"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_section_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chip_gap"
            android:background="@drawable/bg_glass_inner"
            android:orientation="vertical"
            android:padding="@dimen/card_padding_compact">

            <TextView
                android:id="@+id/tvCloudEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_input"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCloudLastBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/micro_gap"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCloudBackup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/cloud_btn_backup"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloudRestore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chip_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_accent_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/cloud_btn_restore"
                android:textColor="@color/accent_sapphire"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloudLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chip_gap"
            android:background="@drawable/bg_pill_danger_soft"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/cloud_btn_logout"
            android:textColor="@color/accent_danger"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_notes_title"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_card_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/micro_gap"
                android:text="@string/profile_notes_subtitle"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnProfileNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_gap"
            android:background="@drawable/bg_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:paddingHorizontal="@dimen/btn_padding_h"
            android:text="@string/profile_notes_btn_open"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
