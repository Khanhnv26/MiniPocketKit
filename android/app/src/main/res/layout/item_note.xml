<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:background="@drawable/bg_glass_card"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="@dimen/card_padding_compact">

    <FrameLayout
        android:id="@+id/btnNoteCheckContainer"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/negative_check_margin_start"
        android:layout_marginTop="@dimen/negative_check_margin_top"
        android:clickable="true"
        android:contentDescription="@string/notes_done_desc"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivNoteCheckBox"
            android:layout_width="@dimen/checkbox_box_size"
            android:layout_height="@dimen/checkbox_box_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_unchecked"
            android:contentDescription="@string/notes_done_desc"
            android:padding="@dimen/tight_gap"
            android:scaleType="centerInside" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tight_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/chip_gap"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tight_gap"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/line_spacing_sm"
            android:maxLines="2"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_button_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNoteSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_neutral_soft"
                android:paddingHorizontal="@dimen/pill_compact_padding_h"
                android:paddingVertical="@dimen/pill_compact_padding_v"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoteTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dialog_button_gap"
                android:textColor="@color/ink_muted"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
