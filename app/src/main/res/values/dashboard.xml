<resources>
    <color name="dashboard_background">#FFEBF1F8</color>
    <color name="dashboard_surface">#D9FFFFFF</color>
    <color name="dashboard_secondary">#FF475569</color>
    <color name="dashboard_text">#FF0F172A</color>
    <color name="dashboard_segment">#FFE2E8F0</color>
    <color name="dashboard_dock">#EEFFFFFF</color>
    <color name="dashboard_deadline_text">#FFDC2626</color>
    <color name="dashboard_green_text">#FF0F766E</color>
    <color name="dashboard_accent">#FF007AFF</color>
    <color name="dashboard_red">#FFDC2626</color>
    <color name="dashboard_green">#FF14B8A6</color>
    <color name="dashboard_teal">#FF38BDF8</color>
    <color name="dashboard_glass_stroke">#FFD9E5F2</color>
    <color name="dashboard_capsule_active">#FF007AFF</color>
    <color name="dashboard_capsule_active_text">#FFFFFFFF</color>
    <color name="dashboard_card_dark">#FF0F172A</color>
    <color name="dashboard_card_dark_stroke">#33FFFFFF</color>
    <color name="dashboard_card_lavender">#E0FFFFFF</color>
    <color name="dashboard_card_lavender_stroke">#FFD9E5F2</color>
    <color name="dashboard_card_lavender_text">#FF0F172A</color>
    <color name="dashboard_timeline_line">#FFD6E2EE</color>

    <string name="dashboard_appearance">Giao diện</string>
    <string name="dashboard_tasks_left">%1$d việc còn lại</string>
    <string-array name="dashboard_theme_options">
        <item>Theo hệ thống</item>
        <item>Sáng</item>
        <item>Tối</item>
    </string-array>

    <style name="Dashboard.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardBackgroundColor">@color/dashboard_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/dashboard_glass_stroke</item>
    </style>

    <style name="Dashboard.Column" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Dashboard.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/dashboard_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Dashboard.Metric" parent="Dashboard.Label">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/dashboard_text</item>
        <item name="android:textSize">32sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Dashboard.Action" parent="Dashboard.Label">
        <item name="android:background">@drawable/dashboard_pill</item>
        <item name="android:backgroundTint">@color/dashboard_segment</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/dashboard_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Dashboard.Tab" parent="Dashboard.Label">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
