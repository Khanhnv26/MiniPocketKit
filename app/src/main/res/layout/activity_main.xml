<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background">
    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            style="@style/Dashboard.Column"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="92dp">

            <!-- ================= HEADER ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:id="@+id/dashboard_header"
                android:layout_marginBottom="14dp">
                <LinearLayout
                    style="@style/Dashboard.Column"
                    android:layout_width="0dp"
                    android:layout_weight="1">
                    <TextView
                        style="@style/Dashboard.Label"
                        android:text="Hôm nay"
                        android:id="@+id/dashboard_date"
                        android:textStyle="bold" />
                    <TextView
                        style="@style/Dashboard.Label"
                        android:text="Mini Pocket Kit"
                        android:textColor="@color/dashboard_text"
                        android:textStyle="bold"
                        android:textSize="27sp"
                        android:fontFamily="sans-serif-black"
                        android:accessibilityHeading="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/theme_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/dashboard_pill"
                    android:backgroundTint="@color/dashboard_segment"
                    android:padding="3dp">
                    <TextView
                        android:id="@+id/theme_light"
                        style="@style/Dashboard.Action"
                        android:text="Sáng"  />
                    <TextView
                        android:id="@+id/theme_dark"
                        style="@style/Dashboard.Action"
                        android:text="Tối"  />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= 1. KHỐI LỊCH HỌC TUẦN (WEEKLY CALENDAR STRIP) ================= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Dashboard.Card"
                android:id="@+id/dashboard_calendar_card">
                <LinearLayout
                    style="@style/Dashboard.Column"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="LỊCH HỌC TRONG TUẦN"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1" />
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="Tuần 7 · Block 5"
                            android:textColor="@color/dashboard_accent"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 7 Ngày trong tuần -->
                    <LinearLayout
                        android:id="@+id/layoutCalendarDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- T2 -->
                        <LinearLayout
                            android:id="@+id/dayBtn0"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/shape_calendar_day_normal"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:id="@+id/tvDayName0"
                                style="@style/Dashboard.Label"
                                android:text="T2"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDayNum0"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09"
                                android:textColor="@color/dashboard_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <Space android:layout_width="4dp" android:layout_height="1dp" />

                        <!-- T3 -->
                        <LinearLayout
                            android:id="@+id/dayBtn1"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/shape_calendar_day_normal"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:id="@+id/tvDayName1"
                                style="@style/Dashboard.Label"
                                android:text="T3"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDayNum1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10"
                                android:textColor="@color/dashboard_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <Space android:layout_width="4dp" android:layout_height="1dp" />

                        <!-- T4 -->
                        <LinearLayout
                            android:id="@+id/dayBtn2"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/shape_calendar_day_normal"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:id="@+id/tvDayName2"
                                style="@style/Dashboard.Label"
                                android:text="T4"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDayNum2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="11"
                                android:textColor="@color/dashboard_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <Space android:layout_width="4dp" android:layout_height="1dp" />

                        <!-- T5 (Hôm nay - Active) -->
                        <LinearLayout
                            android:id="@+id/dayBtn3"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/shape_calendar_day_selected"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:id="@+id/tvDayName3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HÔM NAY"
                                android:textColor="#FFFFFF"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDayNum3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <Space android:layout_width="4dp" android:layout_height="1dp" />

                        <!-- T6 -->
                        <LinearLayout
                            android:id="@+id/dayBtn4"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/shape_calendar_day_normal"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:id="@+id/tvDayName4"
                                style="@style/Dashboard.Label"
                                android:text="T6"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDayNum4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="13"
                                android:textColor="@color/dashboard_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <Space android:layout_width="4dp" android:layout_height="1dp" />

                        <!-- T7 -->
                        <LinearLayout
                            android:id="@+id/dayBtn5"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/shape_calendar_day_normal"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:id="@+id/tvDayName5"
                                style="@style/Dashboard.Label"
                                android:text="T7"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDayNum5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14"
                                android:textColor="@color/dashboard_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <Space android:layout_width="4dp" android:layout_height="1dp" />

                        <!-- CN -->
                        <LinearLayout
                            android:id="@+id/dayBtn6"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="8dp"
                            android:background="@drawable/shape_calendar_day_normal"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:id="@+id/tvDayName6"
                                style="@style/Dashboard.Label"
                                android:text="CN"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvDayNum6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15"
                                android:textColor="@color/dashboard_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thẻ Tiết học kế tiếp / ngày được chọn -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Dashboard.Card"
                android:id="@+id/cardToolTimetable">
                <LinearLayout
                    style="@style/Dashboard.Column"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" >
                        <TextView
                            android:id="@+id/tvTimetableBadge"
                            style="@style/Dashboard.Label"
                            android:text="● TIẾT HỌC KẾ TIẾP"
                            android:textColor="@color/dashboard_green_text"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvTimetableTime"
                            style="@style/Dashboard.Label"
                            android:text="Ca 2 · 09:15 - 11:45"
                            android:textColor="@color/dashboard_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvTimetableSubject"
                        style="@style/Dashboard.Label"
                        android:text="PRM392 · Lập trình Android"
                        android:textColor="@color/dashboard_text"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:id="@+id/tvTimetableRoom"
                        style="@style/Dashboard.Label"
                        android:text="Phòng 302 (Tòa Alpha) · GV Thầy Hoàng"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= 2. KHỐI GHI CHÚ & CHECKLIST NHIỆM VỤ ================= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Dashboard.Card"
                android:id="@+id/dashboard_tasks">
                <LinearLayout
                    style="@style/Dashboard.Column"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="GHI CHÚ &amp; CHECKLIST"
                            android:textColor="@color/dashboard_text"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/task_count"
                            style="@style/Dashboard.Label"
                            android:text="1 việc còn lại"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- THẺ GHI CHÚ ĐÃ GHIM (PINNED NOTE TỪ SQLITE) -->
                    <LinearLayout
                        android:id="@+id/cardPinnedNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/shape_input_rounded"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="📌 ĐÃ GHIM"
                                android:textColor="#E69500"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvPinnedSubject"
                                style="@style/Dashboard.Label"
                                android:text="● PRM392"
                                android:textColor="@color/dashboard_accent"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp" />
                            <TextView
                                android:id="@+id/tvPinnedTime"
                                style="@style/Dashboard.Label"
                                android:text="10:30 hôm nay"
                                android:textSize="11sp"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPinnedTitle"
                            style="@style/Dashboard.Label"
                            android:text="Ôn thi Practical Exam PRM392"
                            android:textColor="@color/dashboard_text"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvPinnedContent"
                            style="@style/Dashboard.Label"
                            android:text="Nắm vững SQLiteOpenHelper, RecyclerView Adapter và Intent."
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- CÁC CHECKBOX NHIỆM VỤ -->
                    <CheckBox
                        android:id="@+id/task_lab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="Nộp bài Lab 3 Android Studio"
                        android:textColor="@color/dashboard_text"
                        android:checked="false"
                        android:buttonTint="@color/dashboard_accent" />
                    <CheckBox
                        android:id="@+id/task_slides"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="Đọc trước Slide RecyclerView"
                        android:textColor="@color/dashboard_text"
                        android:checked="true"
                        android:buttonTint="@color/dashboard_accent" />
                    <CheckBox
                        android:id="@+id/task_attendance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:text="Điểm danh EduNext tiết sáng"
                        android:textColor="@color/dashboard_text"
                        android:checked="true"
                        android:buttonTint="@color/dashboard_accent" />

                    <TextView
                        android:id="@+id/cardToolNotes"
                        style="@style/Dashboard.Action"
                        android:text="Xem tất cả Ghi chú &amp; Checklist →"
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= 3. KHỐI VÒNG HOẠT ĐỘNG (SUMMARY RINGS) ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_summary"
                style="@style/Dashboard.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <com.example.pocketkit.DashboardRingsView
                        android:id="@+id/dashboard_rings"
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:importantForAccessibility="no" />
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />
                    <LinearLayout
                        style="@style/Dashboard.Column"
                        android:layout_width="0dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="3dp">
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="●"
                                android:textColor="@color/dashboard_red"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no" />
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="Bài tập &amp; Deadline"
                                android:layout_width="0dp"
                                android:layout_weight="1" />
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="2 / 3"
                                android:textColor="@color/dashboard_text"
                                android:textStyle="bold"
                                android:layout_marginStart="3dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="3dp">
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="●"
                                android:textColor="@color/dashboard_green"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no" />
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="Tiết học hôm nay"
                                android:layout_width="0dp"
                                android:layout_weight="1" />
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="2 / 3"
                                android:textColor="@color/dashboard_text"
                                android:textStyle="bold"
                                android:layout_marginStart="3dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="3dp">
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="●"
                                android:textColor="@color/dashboard_teal"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no" />
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="Phút Focus"
                                android:layout_width="0dp"
                                android:layout_weight="1" />
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="50 / 75m"
                                android:textColor="@color/dashboard_text"
                                android:textStyle="bold"
                                android:layout_marginStart="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= 4. KHỐI BENTO TOOLS (FOCUS & GPA) ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:id="@+id/dashboard_quick_tools"
                android:baselineAligned="false"
                android:layout_marginBottom="12dp">
                <com.google.android.material.card.MaterialCardView
                    style="@style/Dashboard.Card"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp">
                    <LinearLayout
                        style="@style/Dashboard.Column"
                        android:padding="14dp"
                        android:minHeight="160dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" >
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="Focus Clock"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_focus"
                                app:tint="@color/dashboard_secondary" />
                        </LinearLayout>
                        <Chronometer
                            android:id="@+id/focus_timer"
                            style="@style/Dashboard.Metric"
                            android:countDown="true"
                            android:text="25:00" />
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="Phiên 25 phút chuẩn"  />
                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/cardToolFocus"
                            style="@style/Dashboard.Action"
                            android:text="Bắt đầu"
                            android:layout_width="match_parent"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Dashboard.Card"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp">
                    <LinearLayout
                        style="@style/Dashboard.Column"
                        android:padding="14dp"
                        android:minHeight="160dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" >
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="GPA Dự Tính"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_gpa"
                                app:tint="@color/dashboard_secondary" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" >
                            <TextView
                                style="@style/Dashboard.Metric"
                                android:text="3.42" />
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="/ 4.0"
                                android:layout_marginStart="5dp" />
                        </LinearLayout>
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="5dp"
                            android:max="100"
                            android:progress="86"
                            app:indicatorColor="@color/dashboard_green"
                            app:trackColor="@color/dashboard_segment"
                            app:trackCornerRadius="2dp"
                            app:indicatorTrackGapSize="0dp"
                            app:trackStopIndicatorSize="0dp"
                            app:trackThickness="4dp" />
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="Mục tiêu 3.50 · An toàn"
                            android:textSize="11sp" />
                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/cardToolGpa"
                            style="@style/Dashboard.Action"
                            android:text="Dự đoán môn học"
                            android:layout_width="match_parent"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= 5. DEADLINE & TIỆN ÍCH SINH VIÊN ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_deadline_card"
                style="@style/Dashboard.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <LinearLayout
                        style="@style/Dashboard.Column"
                        android:layout_width="0dp"
                        android:layout_weight="1">
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="●  Còn 2 ngày"
                            android:textColor="@color/dashboard_deadline_text"
                            android:textStyle="bold" />
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="SWP391 · Nộp báo cáo Sprint 2"
                            android:textColor="@color/dashboard_text"
                            android:textStyle="bold"
                            android:textSize="16sp" />
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="Hoàn thiện SRS, Mockup và nộp link LMS"  />
                    </LinearLayout>
                    <Space
                        android:layout_width="7dp"
                        android:layout_height="1dp" />
                    <TextView
                        android:id="@+id/cardToolDeadline"
                        style="@style/Dashboard.Action"
                        android:text="Chi tiết"
                        android:backgroundTint="@color/dashboard_text"
                        android:textColor="@color/dashboard_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:id="@+id/dashboard_documents"
                android:baselineAligned="false"
                android:layout_marginBottom="12dp">
                <com.google.android.material.card.MaterialCardView
                    style="@style/Dashboard.Card"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp">
                    <LinearLayout
                        style="@style/Dashboard.Column"
                        android:padding="14dp"
                        android:minHeight="146dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" >
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="Hồ sơ sinh viên"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_compress"
                                app:tint="@color/dashboard_secondary" />
                        </LinearLayout>
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="Nén CCCD &amp; Ảnh thẻ"
                            android:textColor="@color/dashboard_text"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="&lt; 100KB, 500KB nộp web"  />
                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/cardToolCompress"
                            style="@style/Dashboard.Action"
                            android:text="Mở"
                            android:layout_width="match_parent"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Dashboard.Card"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp">
                    <LinearLayout
                        style="@style/Dashboard.Column"
                        android:padding="14dp"
                        android:minHeight="146dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical" >
                            <TextView
                                style="@style/Dashboard.Label"
                                android:text="Tài liệu học"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:textStyle="bold" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ocr"
                                app:tint="@color/dashboard_secondary" />
                        </LinearLayout>
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="Quét Slide &amp; OCR"
                            android:textColor="@color/dashboard_text"
                            android:textStyle="bold"
                            android:layout_marginTop="6dp" />
                        <TextView
                            style="@style/Dashboard.Label"
                            android:text="Trích văn bản tiếng Việt"  />
                        <Space
                            android:layout_width="1dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/cardToolOcr"
                            style="@style/Dashboard.Action"
                            android:text="Mở"
                            android:layout_width="match_parent"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Dashboard.Card"
                android:id="@+id/dashboard_utilities">
                <LinearLayout
                    style="@style/Dashboard.Column"
                    android:padding="16dp">
                    <TextView
                        style="@style/Dashboard.Label"
                        android:text="Tiện ích"
                        android:textColor="@color/dashboard_text"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/cardToolPdf"
                        style="@style/Dashboard.Action"
                        android:text="Bộ tiện ích PDF"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:id="@+id/cardToolSplitBill"
                        style="@style/Dashboard.Action"
                        android:text="Chia tiền trọ &amp; Điện nước"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:id="@+id/cardToolRandom"
                        style="@style/Dashboard.Action"
                        android:text="Vòng quay bốc thăm"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:id="@+id/cardToolQr"
                        style="@style/Dashboard.Action"
                        android:text="Mã QR"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ================= FLOATING GLASS DOCK (NAVIGATION BAR) ================= -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="7dp"
        app:cardBackgroundColor="@color/dashboard_dock"
        app:cardCornerRadius="32dp"
        app:cardElevation="7dp"
        app:strokeColor="@color/dashboard_glass_stroke"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">
            <TextView
                android:id="@+id/tab_today"
                style="@style/Dashboard.Tab"
                android:text="Hôm nay"
                android:drawableTop="@drawable/ic_home" />
            <TextView
                android:id="@+id/tab_schedule"
                style="@style/Dashboard.Tab"
                android:text="Lịch học"
                android:drawableTop="@drawable/ic_timetable" />
            <TextView
                android:id="@+id/tab_tools"
                style="@style/Dashboard.Tab"
                android:text="Tiện ích"
                android:drawableTop="@drawable/ic_all" />
            <TextView
                android:id="@+id/tab_documents"
                style="@style/Dashboard.Tab"
                android:text="Hồ sơ"
                android:drawableTop="@drawable/ic_profile" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
