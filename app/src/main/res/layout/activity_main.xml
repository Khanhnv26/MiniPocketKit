<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_canvas">

    <include
        android:id="@+id/ambientBackdrop"
        layout="@layout/layout_ambient_backdrop" />

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="108dp">

            <LinearLayout
                android:id="@+id/dashboardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THỨ SÁU, 13 THÁNG 11"
                        android:textColor="@color/accent_sapphire"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Mini Pocket Kit"
                        android:textColor="@color/ink_primary"
                        android:textSize="26sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnHeaderProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pill_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:text="KN"
                    android:textColor="@color/accent_sapphire"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <include
                android:id="@+id/tabHome"
                layout="@layout/tab_home" />

            <include
                android:id="@+id/tabCalendar"
                layout="@layout/tab_calendar"
                android:visibility="gone" />

            <include
                android:id="@+id/tabTools"
                layout="@layout/tab_tools"
                android:visibility="gone" />

            <include
                android:id="@+id/tabProfile"
                layout="@layout/tab_profile"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomDockContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/dockBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dock_bar"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp">

            <LinearLayout
                android:id="@+id/dockTabHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_dock_active_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="52dp"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivDockHome"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Hôm nay"
                    android:src="@drawable/ic_home"
                    app:tint="@color/accent_sapphire" />

                <TextView
                    android:id="@+id/tvDockHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hôm nay"
                    android:textColor="@color/accent_sapphire"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dockTabCalendar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="52dp"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivDockCalendar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Lịch học"
                    android:src="@drawable/ic_timetable"
                    app:tint="@color/ink_secondary" />

                <TextView
                    android:id="@+id/tvDockCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lịch học"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dockTabTools"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="52dp"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivDockTools"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Tiện ích"
                    android:src="@drawable/ic_all"
                    app:tint="@color/ink_secondary" />

                <TextView
                    android:id="@+id/tvDockTools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tiện ích"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dockTabProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="52dp"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/ivDockProfile"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Hồ sơ"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/ink_secondary" />

                <TextView
                    android:id="@+id/tvDockProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hồ sơ"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
