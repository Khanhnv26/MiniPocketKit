<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dialog_outer_padding_h"
    android:layout_marginVertical="@dimen/dialog_outer_padding_v"
    android:background="@drawable/bg_dialog_frost"
    android:orientation="vertical"
    android:padding="@dimen/dialog_inner_padding">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_size_dialog_title"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtDialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_field_gap"
        android:background="@drawable/bg_glass_inner"
        android:ellipsize="end"
        android:hint="@string/notes_dialog_add_category_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:minHeight="@dimen/touch_target_min"
        android:paddingHorizontal="@dimen/btn_padding_h"
        android:paddingVertical="@dimen/card_gap"
        android:singleLine="true"
        android:textColor="@color/ink_primary"
        android:textColorHint="@color/ink_secondary"
        android:textSize="@dimen/text_size_input" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_section_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/notes_dialog_cancel"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_button_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/notes_dialog_add_confirm"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
