<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        style="@style/Dashboard.Column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnBackEditor"
                style="@style/Dashboard.Action"
                android:text="← Quay lại" />

            <TextView
                android:id="@+id/tvEditorHeader"
                style="@style/Dashboard.Label"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Tạo ghi chú mới"
                android:textColor="@color/dashboard_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="72dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Dashboard.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                style="@style/Dashboard.Column"
                android:padding="18dp">

                <TextView
                    style="@style/Dashboard.Label"
                    android:text="TIÊU ĐỀ GHI CHÚ"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/shape_input_rounded"
                    android:hint="Nhập tiêu đề..."
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/dashboard_text"
                    android:textColorHint="@color/dashboard_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Dashboard.Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="MÔN HỌC / PHÂN LOẠI"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAddCategoryInEditor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        android:text="+ Thêm mới"
                        android:textColor="@color/dashboard_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/spnNoteSubject"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/shape_spinner_rounded"
                    android:popupBackground="@drawable/shape_dropdown_popup"
                    android:dropDownVerticalOffset="6dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="36dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    style="@style/Dashboard.Label"
                    android:text="NỘI DUNG CHI TIẾT"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/shape_input_rounded"
                    android:gravity="top|start"
                    android:hint="Viết nội dung ghi chú..."
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="@color/dashboard_text"
                    android:textColorHint="@color/dashboard_secondary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/dashboard_segment" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Icon ghim"
                        android:src="@drawable/ic_pin" />

                    <TextView
                        style="@style/Dashboard.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Ghim lên đầu danh sách"
                        android:textColor="@color/dashboard_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/cbPinNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/dashboard_accent" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btnSaveNote"
            style="@style/Dashboard.Action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/dashboard_text"
            android:text="Lưu ghi chú"
            android:textColor="@color/dashboard_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDeleteNote"
            style="@style/Dashboard.Action"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Xóa ghi chú này"
            android:textColor="@color/dashboard_red"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
