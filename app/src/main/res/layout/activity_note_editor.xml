<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient_canvas">

    <include
        android:id="@+id/ambientBackdrop"
        layout="@layout/layout_ambient_backdrop" />

    <ScrollView
        android:id="@+id/editorScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_h"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingBottom="40dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/section_gap"
                android:minHeight="@dimen/touch_target_min">

                <LinearLayout
                    android:id="@+id/btnBackEditor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_pill_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:contentDescription="@string/editor_back"
                        android:src="@drawable/ic_back"
                        app:tint="@color/ink_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/editor_back"
                        android:textColor="@color/ink_primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEditorHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="108dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/editor_title_create"
                    android:textColor="@color/ink_primary"
                    android:textSize="@dimen/text_size_section_title"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/section_gap"
                android:background="@drawable/bg_glass_hero"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_label_title"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="@dimen/section_gap"
                    android:background="@drawable/bg_glass_inner"
                    android:hint="@string/editor_hint_title"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:minHeight="@dimen/input_min_height"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/ink_primary"
                    android:textColorHint="@color/ink_secondary"
                    android:textSize="@dimen/text_size_input" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_label_category"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="@dimen/section_gap"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutEditorCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_label_content"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="@dimen/section_gap"
                    android:background="@drawable/bg_glass_inner"
                    android:gravity="top|start"
                    android:hint="@string/editor_hint_content"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="@dimen/editor_content_min_height"
                    android:padding="14dp"
                    android:textColor="@color/ink_primary"
                    android:textColorHint="@color/ink_secondary"
                    android:textSize="@dimen/text_size_input" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/card_gap"
                    android:background="@drawable/divider_hairline" />

                <LinearLayout
                    android:id="@+id/layoutPinToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_inner"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/ivEditorPinIcon"
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:contentDescription="@string/note_pin_desc"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/ink_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/editor_pin_label"
                        android:textColor="@color/ink_primary"
                        android:textSize="@dimen/text_size_input"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/pinSwitchTrack"
                        android:layout_width="52dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_switch_track_off"
                        android:padding="3dp">

                        <View
                            android:id="@+id/pinSwitchThumb"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_switch_thumb" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSaveNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/editor_btn_save"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_input"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDeleteNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_danger_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/editor_btn_delete"
                android:textColor="@color/accent_danger"
                android:textSize="@dimen/text_size_input"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
