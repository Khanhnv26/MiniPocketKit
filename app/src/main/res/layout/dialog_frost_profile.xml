<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dialog_outer_padding_h"
    android:layout_marginVertical="@dimen/dialog_outer_padding_v"
    android:background="@drawable/bg_dialog_frost"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profile_dialog_title"
        android:textColor="@color/ink_primary"
        android:textSize="@dimen/text_size_dialog_title"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_dialog_name_label"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_label_gap"
                android:background="@drawable/bg_dialog_input"
                android:hint="@string/profile_dialog_name_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:minHeight="@dimen/input_min_height"
                android:paddingHorizontal="@dimen/card_padding_compact"
                android:singleLine="true"
                android:textColor="@color/ink_primary"
                android:textColorHint="@color/ink_muted"
                android:textSize="@dimen/text_size_input" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:text="@string/profile_dialog_major_label"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtProfileMajor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_label_gap"
                android:background="@drawable/bg_dialog_input"
                android:hint="@string/profile_dialog_major_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:minHeight="@dimen/input_min_height"
                android:paddingHorizontal="@dimen/card_padding_compact"
                android:singleLine="true"
                android:textColor="@color/ink_primary"
                android:textColorHint="@color/ink_muted"
                android:textSize="@dimen/text_size_input" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_dialog_earned_label"
                        android:textColor="@color/ink_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtProfileEarnedCredits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dialog_label_gap"
                        android:background="@drawable/bg_dialog_input"
                        android:fontFeatureSettings="tnum"
                        android:hint="@string/profile_dialog_earned_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:minHeight="@dimen/input_min_height"
                        android:paddingHorizontal="@dimen/card_padding_compact"
                        android:singleLine="true"
                        android:textColor="@color/ink_primary"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="@dimen/text_size_input" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/chip_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_dialog_total_label"
                        android:textColor="@color/ink_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtProfileTotalCredits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dialog_label_gap"
                        android:background="@drawable/bg_dialog_input"
                        android:fontFeatureSettings="tnum"
                        android:hint="@string/profile_dialog_total_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:minHeight="@dimen/input_min_height"
                        android:paddingHorizontal="@dimen/card_padding_compact"
                        android:singleLine="true"
                        android:textColor="@color/ink_primary"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="@dimen/text_size_input" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_dialog_attendance_label"
                        android:textColor="@color/ink_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtProfileAttendance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dialog_label_gap"
                        android:background="@drawable/bg_dialog_input"
                        android:fontFeatureSettings="tnum"
                        android:hint="@string/profile_dialog_attendance_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="3"
                        android:minHeight="@dimen/input_min_height"
                        android:paddingHorizontal="@dimen/card_padding_compact"
                        android:singleLine="true"
                        android:textColor="@color/ink_primary"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="@dimen/text_size_input" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/chip_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_dialog_gpa_label"
                        android:textColor="@color/ink_secondary"
                        android:textSize="@dimen/text_size_caption"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtProfileBaselineGpa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dialog_label_gap"
                        android:background="@drawable/bg_dialog_input"
                        android:fontFeatureSettings="tnum"
                        android:hint="@string/profile_dialog_gpa_hint"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:minHeight="@dimen/input_min_height"
                        android:paddingHorizontal="@dimen/card_padding_compact"
                        android:singleLine="true"
                        android:textColor="@color/ink_primary"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="@dimen/text_size_input" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:text="@string/profile_dialog_term_credits_label"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtProfileTermCredits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_label_gap"
                android:background="@drawable/bg_dialog_input"
                android:fontFeatureSettings="tnum"
                android:hint="@string/profile_dialog_term_credits_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2"
                android:minHeight="@dimen/input_min_height"
                android:paddingHorizontal="@dimen/card_padding_compact"
                android:singleLine="true"
                android:textColor="@color/ink_primary"
                android:textColorHint="@color/ink_muted"
                android:textSize="@dimen/text_size_input" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_section_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnProfileDialogCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/notes_dialog_cancel"
            android:textColor="@color/ink_primary"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProfileDialogSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_button_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/profile_dialog_btn_save"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_input"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
