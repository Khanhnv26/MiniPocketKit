<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:layout_width="@dimen/orb_sky_size"
        android:layout_height="@dimen/orb_sky_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/orb_sky_top_margin"
        android:layout_marginEnd="@dimen/orb_sky_end_margin"
        android:background="@drawable/bg_orb_sky" />

    <View
        android:layout_width="@dimen/orb_mint_size"
        android:layout_height="@dimen/orb_mint_size"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="@dimen/orb_mint_start_margin"
        android:layout_marginTop="@dimen/orb_offset_v"
        android:background="@drawable/bg_orb_mint" />

    <View
        android:layout_width="@dimen/orb_ice_size"
        android:layout_height="@dimen/orb_ice_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/orb_ice_end_margin"
        android:layout_marginBottom="@dimen/orb_offset_v"
        android:background="@drawable/bg_orb_ice" />
</merge>
