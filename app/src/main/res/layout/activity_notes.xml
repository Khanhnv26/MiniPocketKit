<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_pastel"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp">

    <RelativeLayout
        android:id="@+id/layoutNotesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/btnBackFromNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:paddingVertical="6dp"
            android:paddingEnd="12dp"
            android:text="← Trang chủ"
            android:textColor="@color/text_subtitle"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Ghi chú &amp; Checklist"
            android:textColor="@color/text_title"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <EditText
        android:id="@+id/edtSearchNote"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_below="@id/layoutNotesHeader"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_squircle"
        android:backgroundTint="@color/card_bg"
        android:elevation="2dp"
        android:hint="Tìm kiếm theo tiêu đề, môn học..."
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_title"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvEmptyNotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Chưa có ghi chú nào.\nHãy bấm nút bên dưới để tạo mới!"
        android:textAlignment="center"
        android:textColor="@color/text_subtitle"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnAddNote"
        android:layout_below="@id/edtSearchNote"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/btnAddNote"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/shape_gradient_coral"
        android:elevation="4dp"
        android:gravity="center"
        android:text="+ Tạo ghi chú mới"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</RelativeLayout>
