<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notes_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background">

    <LinearLayout
        style="@style/Dashboard.Column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btnBackFromNotes"
                style="@style/Dashboard.Action"
                android:text="← Trang chủ" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                style="@style/Dashboard.Label"
                android:text="PocketKit"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            style="@style/Dashboard.Column"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/Dashboard.Label"
                android:text="HỌC TẬP &amp; NHIỆM VỤ"
                android:textStyle="bold" />

            <TextView
                style="@style/Dashboard.Label"
                android:fontFamily="sans-serif-black"
                android:text="Ghi chú &amp; Checklist"
                android:textColor="@color/dashboard_text"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/dashboard_pill"
            android:backgroundTint="@color/dashboard_segment"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Tìm kiếm"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/edtSearchNote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Tìm kiếm theo tiêu đề, môn học..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/dashboard_text"
                android:textColorHint="@color/dashboard_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/layoutCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/Dashboard.Action"
                    android:backgroundTint="@color/dashboard_text"
                    android:text="Tất cả"
                    android:textColor="@color/dashboard_surface" />

                <TextView
                    android:id="@+id/chipPrm392"
                    style="@style/Dashboard.Action"
                    android:layout_marginStart="6dp"
                    android:text="PRM392" />

                <TextView
                    android:id="@+id/chipSwp391"
                    style="@style/Dashboard.Action"
                    android:layout_marginStart="6dp"
                    android:text="SWP391" />

                <TextView
                    android:id="@+id/chipPinned"
                    style="@style/Dashboard.Action"
                    android:layout_marginStart="6dp"
                    android:text="Đã ghim" />

                <TextView
                    android:id="@+id/btnAddCategory"
                    style="@style/Dashboard.Action"
                    android:layout_marginStart="6dp"
                    android:text="+ Thêm"
                    android:textColor="@color/dashboard_accent" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="92dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tvEmptyNotes"
                style="@style/Dashboard.Label"
                android:layout_gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Chưa có ghi chú nào.\nHãy bấm nút bên dưới để tạo mới!"
                android:textAlignment="center"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btnAddNote"
        style="@style/Dashboard.Action"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/dashboard_text"
        android:elevation="6dp"
        android:minHeight="48dp"
        android:paddingHorizontal="24dp"
        android:text="+ Tạo ghi chú mới"
        android:textColor="@color/dashboard_surface"
        android:textSize="14sp" />

</FrameLayout>
