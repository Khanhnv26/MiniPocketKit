<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="top"
    android:orientation="horizontal"
    android:padding="@dimen/card_padding_compact">

    <FrameLayout
        android:id="@+id/btnNoteCheckContainer"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="-6dp"
        android:clickable="true"
        android:contentDescription="@string/notes_done_desc"
        android:focusable="true">

        <FrameLayout
            android:id="@+id/viewNoteCheckBox"
            android:layout_width="@dimen/checkbox_box_size"
            android:layout_height="@dimen/checkbox_box_size"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_unchecked">

            <ImageView
                android:id="@+id/ivNoteCheck"
                android:layout_width="@dimen/checkbox_check_size"
                android:layout_height="@dimen/checkbox_check_size"
                android:layout_gravity="center"
                android:contentDescription="@string/notes_done_desc"
                android:src="@drawable/ic_check_white"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNoteTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_card_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivNotePinned"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/note_pin_desc"
                android:src="@drawable/ic_pin"
                android:visibility="gone"
                app:tint="@color/accent_sapphire" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNoteSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_neutral_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoteTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/ink_muted"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
