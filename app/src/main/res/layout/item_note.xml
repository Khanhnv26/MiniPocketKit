<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Dashboard.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/cbNoteDone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:buttonTint="@color/dashboard_green" />

        <LinearLayout
            style="@style/Dashboard.Column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoteTitle"
                    style="@style/Dashboard.Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tiêu đề ghi chú"
                    android:textColor="@color/dashboard_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivPinned"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Đã ghim"
                    android:src="@drawable/ic_pin"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNoteContent"
                style="@style/Dashboard.Label"
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="Nội dung tóm tắt ghi chú..."
                android:textColor="@color/dashboard_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNoteSubject"
                    style="@style/Dashboard.Label"
                    android:text="● PRM392"
                    android:textColor="@color/dashboard_green_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Dashboard.Label"
                    android:text=" · "
                    android:textColor="@color/dashboard_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNoteTime"
                    style="@style/Dashboard.Label"
                    android:text="10:30 hôm nay"
                    android:textColor="@color/dashboard_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
