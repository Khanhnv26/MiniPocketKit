<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tabHome"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_glass_hero"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.pocketkit.DashboardRingsView
                android:id="@+id/ringsView"
                android:layout_width="@dimen/home_rings_size"
                android:layout_height="@dimen/home_rings_size" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dock_horizontal_padding"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_ring_deadline_label"
                        android:textColor="@color/ink_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tvRingDeadlineValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/accent_sapphire"
                        android:textSize="@dimen/text_size_input"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/chip_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_ring_class_label"
                        android:textColor="@color/ink_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tvRingClassValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/accent_sky_text"
                        android:textSize="@dimen/text_size_input"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/chip_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_ring_focus_label"
                        android:textColor="@color/ink_secondary"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tvRingFocusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/accent_mint_text"
                        android:textSize="@dimen/text_size_input"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/spotlightCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dock_horizontal_padding"
            android:background="@drawable/bg_glass_inner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding_compact">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSpotlightBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_sapphire"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpotlightTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/ink_primary"
                    android:textSize="@dimen/text_size_spotlight_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSpotlightSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink_secondary"
                    android:textSize="@dimen/text_size_body" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSpotlightAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_gap"
                android:background="@drawable/bg_pill_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:paddingHorizontal="@dimen/dock_horizontal_padding"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/focusTimerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/dock_horizontal_padding">

        <ImageView
            android:layout_width="@dimen/icon_badge_size"
            android:layout_height="@dimen/icon_badge_size"
            android:background="@drawable/bg_icon_badge"
            android:contentDescription="@string/home_timer_focus_desc"
            android:padding="@dimen/dialog_button_gap"
            android:src="@drawable/ic_focus"
            app:tint="@color/accent_sapphire" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_timer_title"
                android:textColor="@color/ink_secondary"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:fontFeatureSettings="tnum"
                android:text="@string/home_timer_default_clock"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_timer_display" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnTimerToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:paddingHorizontal="@dimen/dock_horizontal_padding"
            android:text="@string/home_timer_btn_start"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnTimerReset"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/chip_gap"
            android:background="@drawable/bg_pill_secondary"
            android:contentDescription="@string/home_timer_reset_desc"
            android:padding="@dimen/dialog_field_gap"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh"
            app:tint="@color/ink_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/checklistCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dialog_button_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_checklist_title"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_section_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChecklistCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent_soft"
                android:paddingHorizontal="@dimen/dialog_button_gap"
                android:paddingVertical="@dimen/badge_padding_v"
                android:textColor="@color/accent_sapphire"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHomeOpenNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chip_gap"
                android:background="@drawable/bg_pill_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/touch_target_min"
                android:paddingHorizontal="@dimen/chip_padding_h"
                android:text="@string/home_checklist_notes_btn"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPinnedNoteBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dialog_button_gap"
            android:background="@drawable/bg_glass_inner"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/card_gap"
            android:paddingVertical="@dimen/chip_gap"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_size_sm"
                android:layout_height="@dimen/icon_size_sm"
                android:contentDescription="@string/note_pin_desc"
                android:src="@drawable/ic_pin"
                app:tint="@color/accent_sapphire" />

            <TextView
                android:id="@+id/tvPinnedNoteSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chip_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_primary"
                android:textSize="@dimen/text_size_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chip_gap"
                android:text="@string/home_checklist_pinned_open"
                android:textColor="@color/accent_sapphire"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChecklistEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_inner"
            android:lineSpacingExtra="4dp"
            android:padding="@dimen/card_padding_compact"
            android:text="@string/home_checklist_empty"
            android:textColor="@color/ink_secondary"
            android:textSize="@dimen/text_size_body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/checklistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/divider_hairline"
            android:orientation="vertical"
            android:showDividers="middle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtNewTask"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_inner"
                android:hint="@string/home_task_input_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:minHeight="@dimen/input_min_height"
                android:paddingHorizontal="@dimen/chip_padding_h"
                android:textColor="@color/ink_primary"
                android:textColorHint="@color/ink_secondary"
                android:textSize="@dimen/text_size_input" />

            <ImageButton
                android:id="@+id/btnAddTask"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/dialog_button_gap"
                android:background="@drawable/bg_pill_primary"
                android:contentDescription="@string/home_task_add_desc"
                android:scaleType="center"
                android:src="@drawable/ic_plus"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
